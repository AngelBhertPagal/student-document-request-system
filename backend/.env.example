# Example environment configuration for Student Document Request System
# Copy this file to .env (never commit real secrets)

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Option A: Cloud DATABASE_URL e.g. Render / Railway)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Database (Option B: Local PostgreSQL via Laragon)
DB_NAME=document_request_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional comma-separated HTTPS origins for CSRF (e.g. https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
